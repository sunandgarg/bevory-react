{
  "name": "bevory-edge",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "bevory.in/api/*",
      "zone_name": "bevory.in"
    },
    {
      "pattern": "bevory.in/media/*",
      "zone_name": "bevory.in"
    }
  ],
  "vars": {
    "API_ORIGIN": "https://api.bevory.in"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/seo-routes/*",
      "!/sitemap.xml",
      "!/robots.txt",
      "!/llms.txt",
      "!/sw.js",
      "!/site.webmanifest",
      "!/favicon.ico",
      "!/favicon.png",
      "!/favicon-32x32.png",
      "!/favicon-dark.png",
      "!/favicon-light.png",
      "!/apple-touch-icon.png",
      "!/icon-192.png",
      "!/icon-512.png",
      "!/og-image.png"
    ]
  }
}
